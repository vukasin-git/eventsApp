<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvRatingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rate_event_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvRatingEventName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:paddingBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStar1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★"
            android:textSize="24sp"
            android:textColor="@color/star_inactive"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/btnStar2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★"
            android:textSize="24sp"
            android:textColor="@color/star_inactive"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/btnStar3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★"
            android:textSize="24sp"
            android:textColor="@color/star_inactive"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/btnStar4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★"
            android:textSize="24sp"
            android:textColor="@color/star_inactive"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/btnStar5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★"
            android:textSize="24sp"
            android:textColor="@color/star_inactive"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirmRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_rating" />

</LinearLayout>